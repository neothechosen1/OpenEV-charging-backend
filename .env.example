# --- Convex (set automatically by `npx convex dev` in apps/web) ---
# CONVEX_DEPLOYMENT=
# VITE_CONVEX_URL=

# --- Gateway <-> Convex shared secret (any long random string) ---
GATEWAY_SHARED_SECRET=change-me-long-random

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Wompi (sandbox) — PSE / Nequi / cards in COP, prepaid mode ---
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=test_events_...
# WOMPI_API_URL=https://sandbox.wompi.co   # default; use https://production.wompi.co when live

# --- Mercado Pago (sandbox, adapter roadmap) ---
MERCADOPAGO_ACCESS_TOKEN=TEST-...

# --- AgentMail (emailed receipts) ---
AGENTMAIL_API_KEY=...
AGENTMAIL_INBOX_ID=receipts@yourdomain.agentmail.to

# --- Firecrawl (import electricity tariffs from utility pages) ---
FIRECRAWL_API_KEY=fc-...
